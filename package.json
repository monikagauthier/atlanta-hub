{
  "name": "atlanta-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Página de vendas do ATLANTA HUB — pré-renderizada, sem dependências de runtime.",
  "type": "module",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "qa": "node scripts/qa.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
